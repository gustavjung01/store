{
  "name": "store-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.server.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "bundle:function": "esbuild server/api.ts --bundle --platform=node --target=node24 --format=esm --outfile=build/function/index.mjs --external:pg-native --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\""
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@neondatabase/neon-js": "0.9.0-beta",
    "@neon/functions": "^0.11.0",
    "hono": "^4.13.17",
    "jose": "^6.0.0",
    "pg": "^8.16.0",
    "read-excel-file": "^9.3.12"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "@neon/config": "^1.13.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
